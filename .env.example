# FinX-Plattform environment template.
#
# Copy this file to `.env` and adjust values as needed (or run
# `scripts/compose-setup.ps1` / `scripts/compose-setup.sh`, which copies it and
# fills TDW_MCP_HTTP_TOKEN with a random value). `.env` is loaded by Docker
# Compose only — the Rust binaries read the process environment directly.
#
# Defaults match the `live` compose profile and the local integration-test
# ports. The full reference for every variable is docs/CONFIGURATION.md.
# `*_LIVE=1` flags are TEST-ONLY gates for intentional live-network tests; they
# are never needed at runtime and stay commented here.

# =============================================================================
# Compose infrastructure credentials
# =============================================================================

# Postgres superuser credentials — matched by pg_isready healthcheck and all
# TDW_POSTGRES_URL values below. Change together if overriding.
POSTGRES_USER=tdw
POSTGRES_PASSWORD=tdw
POSTGRES_DB=tdw

# ClickHouse credentials — used by the compose service and TDW_CLICKHOUSE_* vars.
CLICKHOUSE_USER=tdw
CLICKHOUSE_PASSWORD=tdw

# MinIO root credentials — used by the minio service, minio-init, and all
# TDW_S3_ACCESS_KEY / TDW_S3_SECRET_KEY values below. Use strong values in
# any non-local deployment.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# =============================================================================
# Storage backends
# =============================================================================

# Postgres (durable persistence). Inside compose, services use the container
# hostname `postgres`; `POSTGRES_URL` is the host-side URL for cargo tests.
TDW_POSTGRES_URL=postgres://tdw:tdw@postgres:5432/tdw
POSTGRES_URL=postgres://tdw:tdw@localhost:5432/tdw

# S3 / MinIO blob storage.
TDW_S3_ENDPOINT=http://minio:9000
TDW_S3_BUCKET=tdw-default
TDW_S3_ACCESS_KEY=minio
TDW_S3_SECRET_KEY=minio123
TDW_S3_REGION=us-east-1
# Host-side MinIO + S3 integration-test settings.
MINIO_ENDPOINT=http://localhost:9002
TDW_S3_TEST_BUCKET=tdw-default
TDW_S3_TEST_ENDPOINT=http://localhost:9002
TDW_S3_TEST_ACCESS_KEY=minio
TDW_S3_TEST_SECRET_KEY=minio123
TDW_S3_TEST_REGION=us-east-1

# ClickHouse (OLAP). The daemon reads TDW_CLICKHOUSE_URL/_USER/_PASSWORD when
# built with the `real-clickhouse` feature; bootstrap always reads them.
TDW_CLICKHOUSE_URL=http://clickhouse:8123
TDW_CLICKHOUSE_USER=tdw
TDW_CLICKHOUSE_PASSWORD=tdw
# Host-side ClickHouse integration-test endpoint.
TDW_CLICKHOUSE_TEST_URL=http://localhost:8123
TDW_CLICKHOUSE_TEST_USER=tdw
TDW_CLICKHOUSE_TEST_PASSWORD=tdw

# Qdrant (vector). The daemon reads these with the `real-qdrant` feature.
TDW_QDRANT_URL=http://qdrant:6333
# TDW_QDRANT_API_KEY=
# Host-side Qdrant integration-test endpoint.
TDW_QDRANT_TEST_URL=http://localhost:6333
# TDW_QDRANT_TEST_API_KEY=

# Meilisearch (lexical). Read by bootstrap to create the baseline index.
TDW_MEILI_URL=http://meilisearch:7700
# TDW_MEILI_API_KEY=
# Host-side Meilisearch integration-test endpoint.
TDW_MEILISEARCH_TEST_URL=http://localhost:7700
# TDW_MEILISEARCH_TEST_API_KEY=

# =============================================================================
# Daemon (tdw-service / tdw-service-daemon)
# =============================================================================

# Runtime profile. `prod`/`production` enable fail-closed OIDC ingress auth;
# any other value attaches a local-default policy. The `live` stack uses
# `docker`. Set in compose per service; uncomment to override globally.
# TDW_PROFILE=docker

# Daemon TCP bind. Use 0.0.0.0:7878 in a container so siblings can reach it.
# The transport is unauthenticated plaintext — keep it internal-only.
# TDW_DAEMON_TCP_BIND=0.0.0.0:7878

# Attach the local-dev policy regardless of TDW_PROFILE (escape hatch before
# OIDC is wired). Set to 1 to opt in.
# TDW_DAEMON_OPEN_POLICY=1

# Postgres-back the daemon's own session + rollout stores (needs the
# `daemon-postgres` feature). Falls back to DATABASE_URL.
# TDW_DAEMON_PG_URL=postgres://tdw:tdw@postgres:5432/tdw

# Agent memory directory + consolidation tick (seconds, default 3600).
# TDW_MEMORY_DIR=/var/lib/tdw/memory
# TDW_CONSOLIDATION_TICK_SECS=3600

# Production OIDC ingress auth (TDW_OIDC_*). Read ONLY when TDW_PROFILE is
# prod|production; inert otherwise. Fail-closed by default: leave all unset to
# stay fail-closed, or set all five required vars to attach an auth-backed
# policy. JWKS is comma-separated kid:alg pairs (allowed algs: RS256, ES256).
# Validation is STRUCTURAL, not cryptographic. See
# docs/release/production-auth-oidc.md.
# TDW_OIDC_ISSUER=https://issuer.example
# TDW_OIDC_AUDIENCE=tdw-daemon
# TDW_OIDC_JWKS=key1:RS256,key2:ES256
# TDW_OIDC_SUBJECT=svc:prod
# TDW_OIDC_KID=key1
# TDW_OIDC_ROLES=analyst,udf_runner

# =============================================================================
# Worker (tdw-worker --serve)
# =============================================================================

# Postgres queue (needs the `postgres` feature). Falls back to DATABASE_URL.
# Unset = SQLite (TDW_WORKER_DB, default sqlite://tdw-worker.sqlite).
# TDW_WORKER_PG_URL=postgres://tdw:tdw@postgres:5432/tdw
# TDW_WORKER_DB=sqlite://tdw-worker.sqlite
# TDW_WORKER_ID=tdw-worker
# TDW_WORKER_LEASE_TTL_MS=30000
# TDW_WORKER_POLL_MS=500
# TDW_WORKER_CONCURRENCY=4
# Dispatch leased jobs to the daemon instead of the offline ack handler.
# TDW_WORKER_DISPATCH=daemon
# TDW_WORKER_DAEMON_ADDR=tdw-service-daemon:7878
# TDW_WORKER_DAEMON_TRANSPORT=tcp
# TDW_WORKER_DAEMON_TIMEOUT_MS=2000

# =============================================================================
# MCP server (tdw-mcp --streamable-http)
# =============================================================================

# Bearer token for the Streamable-HTTP server. REQUIRED (no default) before a
# non-loopback bind: `docker compose --profile live up` fails fast if unset, and
# the server refuses a non-loopback bind without it. Use a strong, unique value
# (`openssl rand -hex 32`); `compose-setup` fills this automatically. The dev
# placeholder below is NOT safe for exposure.
TDW_MCP_HTTP_TOKEN=change-me-before-exposing
# Daemon endpoint the MCP server routes daemon-backed tools to.
# TDW_MCP_DAEMON_ADDR=tdw-service-daemon:7878
# TDW_MCP_DAEMON_TRANSPORT=tcp
# TDW_MCP_DAEMON_TIMEOUT_MS=5000

# =============================================================================
# LLM and embeddings
# =============================================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TDW_OPENAI_COMPAT_API_KEY=
# Embedding backend selector: hash|local (offline default), openai (needs the
# `openai` feature), google (needs the `google` feature).
# TDW_EMBED_PROVIDER=hash
# TDW_EMBED_MODEL=text-embedding-3-small
TDW_OPENAI_EMBEDDING_API_KEY=
# TDW_OPENAI_EMBEDDING_BASE_URL=
GOOGLE_API_KEY=
GEMINI_API_KEY=
TDW_GOOGLE_EMBEDDING_API_KEY=
# TDW_GOOGLE_EMBEDDING_BASE_URL=

# =============================================================================
# Market-data provider credentials
# =============================================================================
# Only consumed when the provider's live HTTP fetcher is compiled in (the
# per-provider cargo feature or `all-http-providers`). The offline default build
# ignores these. Public-endpoint providers (Yahoo, CBOE, AkShare, Binance,
# Deribit, ECB, FINRA, GeckoTerminal, OECD, SEC EDGAR, TMX) need no key.

POLYGON_API_KEY=
FRED_API_KEY=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
COINGECKO_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_TOKEN=
HF_API_TOKEN=
TDW_ADANOS_API_KEY=
TDW_ALPHA_VANTAGE_API_KEY=
TDW_BENZINGA_API_KEY=
TDW_BLS_API_KEY=
TDW_CCDATA_API_KEY=
TDW_DATABENTO_API_KEY=
TDW_EIA_API_KEY=
TDW_FMP_API_KEY=
TDW_GLASSNODE_API_KEY=
TDW_NASDAQ_API_KEY=
TDW_SEEKING_ALPHA_API_KEY=
TDW_TIINGO_API_KEY=
TDW_TRADING_ECONOMICS_API_KEY=
TDW_TRADIER_API_KEY=
TDW_VELODATA_API_KEY=

