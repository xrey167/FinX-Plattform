# Copy this file to `.env` and adjust values as needed. Defaults
# match the `live` compose profile and local integration-test ports.

# Postgres (G013 durable persistence backends).
# Inside compose, `tdw-bootstrap` uses the container hostname.
TDW_POSTGRES_URL=postgres://tdw:tdw@postgres:5432/tdw
# Host-side URL for cargo integration tests.
POSTGRES_URL=postgres://tdw:tdw@localhost:5432/tdw

# S3 / MinIO (G010 blob storage).
TDW_S3_ENDPOINT=http://minio:9000
TDW_S3_BUCKET=tdw-default
TDW_S3_ACCESS_KEY=minio
TDW_S3_SECRET_KEY=minio123
TDW_S3_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9002
TDW_S3_TEST_BUCKET=tdw-default
TDW_S3_TEST_ENDPOINT=http://localhost:9002
TDW_S3_TEST_ACCESS_KEY=minio
TDW_S3_TEST_SECRET_KEY=minio123
TDW_S3_TEST_REGION=us-east-1

# Live storage integration-test endpoints.
TDW_CLICKHOUSE_TEST_URL=http://localhost:8123
TDW_CLICKHOUSE_TEST_USER=tdw
TDW_CLICKHOUSE_TEST_PASSWORD=tdw
TDW_QDRANT_TEST_URL=http://localhost:6333
TDW_MEILISEARCH_TEST_URL=http://localhost:7700

# MCP Streamable HTTP server (`live` profile `tdw-mcp-serve`). Required before
# `docker compose --profile live up` — a non-loopback bind on a host-published
# port must be authenticated. Use a strong, unique value (e.g.
# `openssl rand -hex 32`); the dev placeholder below is NOT safe for exposure.
TDW_MCP_HTTP_TOKEN=change-me-before-exposing

# LLM and embedding credentials (G012 transports).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TDW_OPENAI_COMPAT_API_KEY=
TDW_OPENAI_EMBEDDING_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
TDW_GOOGLE_EMBEDDING_API_KEY=

# Provider credentials (G011 transports).
POLYGON_API_KEY=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
FRED_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_TOKEN=
HF_API_TOKEN=

# Live test gates. Uncomment only for intentional live network tests.
# TDW_ANTHROPIC_LIVE=1
# TDW_OPENAI_COMPAT_LIVE=1
# TDW_OPENAI_EMBEDDING_LIVE=1
# TDW_GOOGLE_EMBEDDING_LIVE=1
# TDW_YAHOO_LIVE=1
# TDW_FRED_LIVE=1
# TDW_ALPACA_LIVE=1
# TDW_BINANCE_LIVE=1
# TDW_POLYGON_LIVE=1
# TDW_HUGGINGFACE_LIVE=1
