{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "AllowOnce",
        "AlwaysAllow",
        "Deny"
      ],
      "type": "string"
    },
    "CostHint": {
      "properties": {
        "backend": {
          "type": "string"
        },
        "estimated_bytes_scanned": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "estimated_rows_read": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "backend"
      ],
      "type": "object"
    },
    "TimeRange": {
      "properties": {
        "end": {
          "type": "string"
        },
        "start": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "const": "append_user_message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "cost_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostHint"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sql": {
          "type": "string"
        },
        "type": {
          "const": "run_query",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sql"
      ],
      "type": "object"
    },
    {
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbols": {
          "default": [],
          "description": "Symbols to ingest in this batch. Each is fetched and persisted\nindependently (with its own deduplication token), so a single op can\nfan out across a watchlist. Must be non-empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "ingest_batch",
          "type": "string"
        }
      },
      "required": [
        "type",
        "provider",
        "endpoint"
      ],
      "type": "object"
    },
    {
      "properties": {
        "arguments": true,
        "call_id": {
          "type": "string"
        },
        "permission_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_name": {
          "type": "string"
        },
        "type": {
          "const": "tool_call",
          "type": "string"
        }
      },
      "required": [
        "type",
        "call_id",
        "tool_name",
        "arguments"
      ],
      "type": "object"
    },
    {
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "permission_id": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "approval_response",
          "type": "string"
        }
      },
      "required": [
        "type",
        "permission_id",
        "decision"
      ],
      "type": "object"
    },
    {
      "properties": {
        "target_tokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "compact_context",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target_tokens"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op_id": {
          "type": "string"
        },
        "type": {
          "const": "cancel",
          "type": "string"
        }
      },
      "required": [
        "type",
        "op_id"
      ],
      "type": "object"
    },
    {
      "description": "Fetch a fresh last-price quote snapshot for `symbol` from the named\n`provider`. This is a **no-cache read**: the daemon calls the provider's\nHTTP endpoint on every dispatch and returns the result directly without\nwriting to any storage layer. Intended for real-time consumers such as a\nprice-alert engine that evaluate `current_price` against thresholds on\nevery trigger cycle. Serializes as `get_quote_snapshot`.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "type": {
          "const": "get_quote_snapshot",
          "type": "string"
        }
      },
      "required": [
        "type",
        "provider",
        "symbol"
      ],
      "type": "object"
    },
    {
      "description": "Start a live streaming-ingest task for `provider`/`symbol`, draining the\nprovider's websocket subscription into the (optional) `table` (defaulting\nto the provider's bronze landing table). Serializes as `stream_start`.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "stream_start",
          "type": "string"
        }
      },
      "required": [
        "type",
        "provider",
        "symbol"
      ],
      "type": "object"
    },
    {
      "description": "Stop a previously started streaming-ingest task identified by\n`stream_id`. Serializes as `stream_stop`.",
      "properties": {
        "stream_id": {
          "type": "string"
        },
        "type": {
          "const": "stream_stop",
          "type": "string"
        }
      },
      "required": [
        "type",
        "stream_id"
      ],
      "type": "object"
    },
    {
      "description": "Create a new price alert for the authenticated principal. The server\nderives `owner_id` from the verified JWT subject — it is **never** read\nfrom the request payload. `target_price` is a decimal string (e.g.\n`\"123.45\"`) — carrying it as `String` preserves `Op: Eq` (f64 is not\n`Eq`) and avoids NaN-in-protocol. The dispatcher validates it is a\nfinite, positive number. `condition` is the `AlertDirection` text:\n`\"Above\"` or `\"Below\"`. Serializes as `create_alert`.",
      "properties": {
        "condition": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "target_price": {
          "type": "string"
        },
        "type": {
          "const": "create_alert",
          "type": "string"
        }
      },
      "required": [
        "type",
        "symbol",
        "target_price",
        "condition"
      ],
      "type": "object"
    },
    {
      "description": "List all price alerts owned by the authenticated principal, newest\nfirst. No filter parameters — owner scoping is enforced server-side\nfrom the verified JWT subject. Serializes as `list_alerts`.",
      "properties": {
        "type": {
          "const": "list_alerts",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "description": "Delete the price alert with `id`. The server verifies that the alert\nbelongs to the authenticated principal before deleting; a mismatched or\nnon-existent id returns an error that does **not** leak existence.\nSerializes as `delete_alert`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "delete_alert",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    {
      "description": "Enable or disable the price alert with `id`. Same server-side ownership\ncheck as `DeleteAlert`. Serializes as `set_alert_active`.",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "set_alert_active",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "active"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "shutdown",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "Op"
}
