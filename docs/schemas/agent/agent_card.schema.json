{
  "$defs": {
    "Adaptivity": {
      "description": "Ordinal degree to which an entity changes itself over time.",
      "oneOf": [
        {
          "const": "None",
          "description": "Static.",
          "type": "string"
        },
        {
          "const": "Configured",
          "description": "Parameterized but not self-changing.",
          "type": "string"
        },
        {
          "const": "Learning",
          "description": "Learns/updates from feedback or data.",
          "type": "string"
        },
        {
          "const": "SelfModifying",
          "description": "Rewrites its own structure (e.g. memory consolidation).",
          "type": "string"
        }
      ]
    },
    "AgentSkill": {
      "properties": {
        "input_schema": true,
        "meta": {
          "$ref": "#/$defs/EntityMeta"
        },
        "output_schema": true,
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillQuality"
            },
            {
              "type": "null"
            }
          ],
          "description": "Eval-driven quality state, present only after gated feedback has been applied."
        }
      },
      "required": [
        "meta",
        "input_schema",
        "output_schema"
      ],
      "type": "object"
    },
    "ContentKind": {
      "enum": [
        "Document",
        "Dataset",
        "Prompt",
        "Workflow",
        "Tool"
      ],
      "type": "string"
    },
    "ContentRef": {
      "properties": {
        "checksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ContentKind"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uri": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "uri",
        "kind"
      ],
      "type": "object"
    },
    "EntityMeta": {
      "description": "The shared metadata envelope embedded by every entity kind (the CRD `metadata`).\n\nCarries [`BaseMetadata`] (flattened, so `name`/`title`/… sit at the top level) plus the\n`FinX` classification and a forward-compatible `_meta` bag for unknown fields.",
      "properties": {
        "_meta": {
          "additionalProperties": true,
          "description": "Forward-compatibility bag for unknown/future metadata fields.",
          "type": "object"
        },
        "adaptivity": {
          "$ref": "#/$defs/Adaptivity",
          "description": "Degree of self-change."
        },
        "autonomous": {
          "description": "Whether this entity is an autonomous actor (true only for agents).",
          "type": "boolean"
        },
        "description": {
          "description": "Optional human-readable description (a model-facing hint).",
          "type": [
            "string",
            "null"
          ]
        },
        "icons": {
          "description": "Optional display icons.",
          "items": {
            "$ref": "#/$defs/Icon"
          },
          "type": "array"
        },
        "id": {
          "description": "Internal stable identifier (ULID-shaped).",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "Unique programmatic identifier; also the display fallback.",
          "minLength": 1,
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "Orthogonal classification."
        },
        "tags": {
          "description": "Free-form tags.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "Optional human-readable display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Semantic version of this definition.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "id",
        "version",
        "origin",
        "adaptivity",
        "autonomous"
      ],
      "type": "object"
    },
    "Icon": {
      "description": "A display icon descriptor (`src` + optional MIME type and size hints).",
      "properties": {
        "mimeType": {
          "description": "Optional MIME type (e.g. `image/png`).",
          "type": [
            "string",
            "null"
          ]
        },
        "sizes": {
          "description": "Optional space-separated size hints (e.g. `\"48x48 96x96\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "src": {
          "description": "Source URI of the icon (`data:` or `https:`).",
          "type": "string"
        }
      },
      "required": [
        "src"
      ],
      "type": "object"
    },
    "Origin": {
      "description": "Orthogonal entity classification.\n\nThis is NOT lineage: where a particular piece of *data* came from is recorded by a\nseparate `provenance` field. `Origin` classifies the kind itself.",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Whether the kind bridges outside the platform."
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "How built-in/specialized the kind is."
        }
      },
      "required": [
        "tier",
        "source"
      ],
      "type": "object"
    },
    "SkillQuality": {
      "description": "Eval-driven quality state attached to a skill once it has received feedback.\n\nDefaults to \"never evaluated\" (all-`None`/zero). Mutated only through\n[`AgentSkill::apply_eval_feedback`], which is gated by the [`Adaptivity`] axis — a\n`None`/`Configured` skill never accrues quality state. The field is additive and skipped\nwhen absent, so existing golden fixtures serialize byte-identically.",
      "properties": {
        "disabled": {
          "description": "Whether the latest run disabled this skill (pass rate fell below the threshold).",
          "type": "boolean"
        },
        "lastEval": {
          "description": "When the last eval feedback was applied (RFC 3339).",
          "type": [
            "string",
            "null"
          ]
        },
        "lastEvalScore": {
          "description": "The score from the most recent eval (currently the same as `pass_rate`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "passRate": {
          "description": "The most recent run's aggregate pass rate (`0.0..=1.0`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "runs": {
          "description": "How many eval runs have fed back into this skill.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "runs",
        "disabled"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Origin source — whether the kind is defined inside the platform or bridges outside.",
      "oneOf": [
        {
          "const": "Internal",
          "description": "Defined inside the platform/user.",
          "type": "string"
        },
        {
          "const": "External",
          "description": "Wraps or mirrors a third-party standard or service.",
          "type": "string"
        }
      ]
    },
    "Tier": {
      "description": "Origin tier — how built-in or specialized an entity kind is.",
      "oneOf": [
        {
          "const": "System",
          "description": "Platform primitive.",
          "type": "string"
        },
        {
          "const": "Domain",
          "description": "Finance/trading-domain specific.",
          "type": "string"
        },
        {
          "const": "Custom",
          "description": "User-authored at runtime.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "content_refs": {
      "items": {
        "$ref": "#/$defs/ContentRef"
      },
      "type": "array"
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta": {
      "$ref": "#/$defs/EntityMeta"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/AgentSkill"
      },
      "type": "array"
    }
  },
  "required": [
    "meta"
  ],
  "title": "AgentCard",
  "type": "object"
}
