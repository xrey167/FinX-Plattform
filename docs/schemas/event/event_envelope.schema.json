          "type": [
            "string",
            "null"
          ]
        },
        "span_id": {
          "minLength": 1,
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ],
      "type": "object"
    }
