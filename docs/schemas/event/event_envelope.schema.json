        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "depth": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "occurred_at": {
      "minLength": 1,
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "payload": true,
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "trace": {
